# Base de datos. Local: SQLite (default). Producción: Supabase Postgres
# (usar la URL del Session Pooler: postgresql+psycopg://USER:PASS@HOST:5432/postgres)
DATABASE_URL=sqlite:///./data/ideographco.db

# Filtro de politicidad (Gemini, free tier). Lo usan la ingesta y la mesa de
# redacción (POST /classify). Sin key → el filtro se salta: la mesa confía en
# el usuario y clasifica todo texto.
GEMINI_API_KEY=

# Clasificador ideológico (servicio externo, repo IdeoGraphCO).
# mock  = distribuciones deterministas de prueba (default, para desarrollo)
# http  = POST {CLASSIFIER_API_URL}/classify
# off   = no clasifica (los artículos quedan pending y las stories no se publican)
CLASSIFIER_MODE=mock
CLASSIFIER_API_URL=

# Orígenes permitidos para CORS (CSV)
CORS_ORIGINS=http://localhost:3000
